TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=
DB_PATH=./data/schedule.db
PDF_CACHE_DIR=./data/pdf_cache
WEEKTYPE_URL=https://www.vavilovsar.ru/ucheba/raspisanie-zanyatii

# Defaults applied to every NEW institute created via /add_institute.
# Per-institute values live in SQLite and are changed at runtime with
# /set_institute_send_time, /set_institute_check_interval and
# /set_institute_catalog_interval — not here.
DAILY_SEND_TIME=09:00
CHECK_INTERVAL_MINUTES=60
# How often the institute's catalog page is re-scanned for PDF links
# (minutes). 10080 = once a week.
CATALOG_REFRESH_INTERVAL_MINUTES=10080
TIMEZONE=Europe/Moscow
