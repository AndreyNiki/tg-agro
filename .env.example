TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=
DB_PATH=./data/schedule.db
PDF_CACHE_DIR=./data/pdf_cache
WEEKTYPE_URL=https://www.vavilovsar.ru/ucheba/raspisanie-zanyatii
DAILY_SEND_TIME=09:00
CHECK_INTERVAL_MINUTES=60
TIMEZONE=Europe/Moscow

# Required ONLY when upgrading a pre-existing single-group deployment (one
# that predates multi-group support) to this version — a fresh install
# never needs this. It must point at the page listing links to every
# group's PDF schedule, so the migration can re-discover a PDF link for
# the one legacy group that was previously configured via GROUP_NAME/
# PDF_SOURCE. If legacy data is detected in the database and this is not
# set, the app raises and refuses to start.
# LEGACY_GROUP_SOURCE_PAGE_URL=https://www.vavilovsar.ru/ucheba/raspisanie-zanyatii
