TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=
DB_PATH=./data/schedule.db
PDF_CACHE_DIR=./data/pdf_cache
WEEKTYPE_URL=https://www.vavilovsar.ru/ucheba/raspisanie-zanyatii

# Defaults applied to every NEW institute created via /add_institute.
# Per-institute values live in SQLite and are changed at runtime with
# /set_institute_send_time, /set_institute_check_interval and
# /set_institute_catalog_interval — not here.
DAILY_SEND_TIME=09:00
CHECK_INTERVAL_MINUTES=60
# How often the institute's catalog page is re-scanned for PDF links
# (minutes). 10080 = once a week.
CATALOG_REFRESH_INTERVAL_MINUTES=10080
TIMEZONE=Europe/Moscow

# Local testing only. HTTP_PROXY/HTTPS_PROXY (set elsewhere in the
# environment) are picked up both by the Telegram Bot API client (httpx)
# and by requests to the institute's site/PDFs (curl_cffi). Set this to 1
# to make ONLY the site/PDF requests ignore the proxy, while Telegram API
# traffic keeps using it.
# DISABLE_SITE_PROXY=1

# One-time migration of every existing `members` row onto one group —
# for moving users off the single hardcoded group the bot used before
# institutes existed. All three vars are required together; if even one
# is missing/empty, the migration is fully disabled. Once it succeeds,
# it is recorded in the `settings` table (legacy_migration_done_at) and
# never runs again, even if these stay set.
# LEGACY_MIGRATION_INSTITUT=https://www.vavilovsar.ru/.../institut-agrobiznesa
# LEGACY_MIGRATION_INSTITUT_NAME=Институт агробизнеса
# LEGACY_MIGRATION_GROUP_NAME=Б-Мв-101
